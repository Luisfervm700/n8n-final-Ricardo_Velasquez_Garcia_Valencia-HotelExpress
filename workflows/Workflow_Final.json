    {
      "parameters": {
        "name": "consultar_disponibilidad",
        "description": "SOLO LECTURA. Calcula disponibilidad utilizando exclusivamente el inventario y las reservas consultadas en Baserow durante esta ejecución. Recibe query como JSON texto {\"tipo\":\"Doble\",\"fecha_entrada\":\"2026-12-10\",\"fecha_salida\":\"2026-12-12\"}. No crea ni modifica reservas. Si devuelve ok:false, NO afirmes que existe disponibilidad.",
        "language": "javaScript",
        "jsCode": "// Code Tool v1.3: recibe query; los datos provienen de un nodo Code ejecutado antes.\nlet p;\ntry { p = typeof query === 'string' ? JSON.parse(query) : query; }\ncatch { return JSON.stringify({ok:false,error:'PARAMETROS_INVALIDOS',mensaje:'Proporciona tipo y fechas AAAA-MM-DD'}); }\nif (!p || typeof p !== 'object' || Array.isArray(p)) return JSON.stringify({ok:false,error:'PARAMETROS_INVALIDOS',mensaje:'Se necesita un objeto JSON'});\nconst tipo = String(p.tipo ?? p.tipo_habitacion ?? '').trim().toLowerCase();\nconst entrada = String(p.fecha_entrada ?? p.entrada ?? '').trim();\nconst salida = String(p.fecha_salida ?? p.salida ?? '').trim();\nconst fechaOK = s => /^\\d{4}-\\d{2}-\\d{2}$/.test(s) && Number.isFinite(new Date(s+'T00:00:00Z').getTime()) && new Date(s+'T00:00:00Z').toISOString().slice(0,10) === s;\nif (!tipo || tipo.length > 60 || !fechaOK(entrada) || !fechaOK(salida) || salida <= entrada) {\n  return JSON.stringify({ok:false,error:'PARAMETROS_INVALIDOS',mensaje:'Se necesita tipo válido y fechas reales; salida posterior a entrada'});\n}\ntry {\n  // Solo se consulta el contexto normalizado; nunca se usa inventario fabricado por el modelo.\n  const ctx = $('Chat - Contexto seguro').first().json;\n  if (!Array.isArray(ctx?.habitaciones) || !Array.isArray(ctx?.reservas)) throw new Error('El contexto está incompleto');\n  const habitaciones = ctx.habitaciones.filter(h=>h.Activa===true && h.Tipo.toLowerCase()===tipo);\n  const reservas = ctx.reservas;\n  const libre = [...habitaciones].sort((a,b)=>a.Numero.localeCompare(b.Numero,undefined,{numeric:true})).find(h=>\n    !reservas.some(r=>r.Habitacion===h.Numero && r.Entrada<salida && r.Salida>entrada)\n  );\n  return JSON.stringify({ok:true,tipo,fecha_entrada:entrada,fecha_salida:salida,disponible:!!libre,\n    habitacion:libre?libre.Numero:null,motivo:libre?'DISPONIBLE':'SIN_DISPONIBILIDAD',habitaciones_revisadas:habitaciones.length});\n} catch {\n  return JSON.stringify({ok:false,error:'CONTEXTO_NO_DISPONIBLE',mensaje:'No se pudo consultar la disponibilidad en este momento'});\n}"
      },
