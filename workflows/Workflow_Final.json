      "parameters": {
        "jsCode": "const e = $input.first().json || {};\nconst msg = String(e.error_tecnico || e.error?.message || e.message || 'Error técnico durante la reserva').slice(0,500);\nreturn [{json:{Fecha:new Date().toISOString(),Proyecto:'Reservas Hotel',Workflow:'Hotel Express - Workflow Final Unificado',Ejecucion_ID:String($execution.id||'no_disponible'),Ejecucion_URL:'',Nodo:'Consulta o creación de reserva (ver ejecucion)',Solicitud_Ref:'no_disponible',Mensaje:msg,Estado:'pendiente_revision'}}];"
