    {
      "parameters": {
        "jsCode": "const s = $('Validar y normalizar').first().json;\nconst entrada = s.Entrada, salida = s.Salida;\nconst email = String(s.Email || '').toLowerCase();\nconst leer = nombre => {\n  const paginas = $(nombre).all();\n  if (!paginas.length) throw new Error('RESPUESTA_VACIA: ' + nombre);\n  const filas=[];\n  for (const p of paginas) {\n    if (!Array.isArray(p.json.results)) throw new Error('RESPUESTA_INESPERADA: ' + nombre);\n    filas.push(...p.json.results);\n  }\n  if (paginas[paginas.length-1].json.next) throw new Error('PAGINACION_INCOMPLETA: ' + nombre);\n  return filas;\n};\ntry {\n  const habitaciones = leer('Consultar habitaciones');\n  const reservas = leer('Consultar reservas').filter(r => String(r.Estado||'').toLowerCase()==='confirmada');\n  const numeros = new Set(habitaciones.map(h=>String(h.Numero)));\n  const base = {habitaciones_revisadas:habitaciones.length,reservas_revisadas:reservas.length};\n  const existente = reservas.find(r => String(r.Email||'').toLowerCase()===email && r.Entrada===entrada && r.Salida===salida && numeros.has(String(r.Habitacion)));\n  if (existente) return [{json:{...base,disponible:false,duplicada:true,motivo:'RESERVA_DUPLICADA',habitacion:String(existente.Habitacion),reserva_existente_id:String(existente.id)}}];\n  const ocupada = num => reservas.some(r => String(r.Habitacion)===num && r.Entrada<salida && r.Salida>entrada);\n  const libre = [...habitaciones].sort((a,b)=>String(a.Numero).localeCompare(String(b.Numero),undefined,{numeric:true})).find(h=>!ocupada(String(h.Numero)));\n  return [{json:{...base,disponible:!!libre,duplicada:false,motivo:libre?'DISPONIBLE':'SIN_DISPONIBILIDAD',habitacion:libre?String(libre.Numero):null,reserva_existente_id:null}}];\n} catch (e) {\n  return [{json:{disponible:false,error_tecnico:'VALIDACION_DE_CONSULTA: '+String(e.message||e)}}];\n}"
      },
