    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json || {};\nconst texto = v => typeof v === 'string' ? v.trim() : '';\nconst fechaValida = v => {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(v)) return false;\n  const fecha = new Date(v + 'T00:00:00Z');\n  return Number.isFinite(fecha.getTime()) && fecha.toISOString().slice(0,10) === v;\n};\nconst cliente = texto(d.nombre ?? d.Cliente);\nconst email = texto(d.email ?? d.Email).toLowerCase();\nconst entrada = texto(d.fecha_entrada ?? d.entrada ?? d.Entrada);\nconst salida = texto(d.fecha_salida ?? d.salida ?? d.Salida);\nconst tipoRaw = texto(d.tipo_habitacion ?? d.tipo ?? d.Tipo);\nconst tipo = tipoRaw ? tipoRaw[0].toUpperCase() + tipoRaw.slice(1).toLowerCase() : '';\nconst rawHuespedes = d.huespedes ?? d.Huespedes;\nconst num = (typeof rawHuespedes === 'number' || typeof rawHuespedes === 'string') && String(rawHuespedes).trim() ? Number(rawHuespedes) : NaN;\nconst huespedes = Number.isInteger(num) ? num : 0;\nconst fechasOk = fechaValida(entrada) && fechaValida(salida);\nconst errores = [];\nif (!cliente) errores.push('nombre es obligatorio');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errores.push('email no es valido');\nif (!fechaValida(entrada)) errores.push('fecha_entrada debe ser una fecha real AAAA-MM-DD');\nif (!fechaValida(salida)) errores.push('fecha_salida debe ser una fecha real AAAA-MM-DD');\nif (fechasOk && salida <= entrada) errores.push('fecha_salida debe ser posterior a fecha_entrada');\nif (huespedes < 1) errores.push('huespedes debe ser un entero positivo');\nif (!tipo) errores.push('tipo_habitacion es obligatorio');\nconst noches = fechasOk && salida > entrada ? Math.round((new Date(salida + 'T00:00:00Z') - new Date(entrada + 'T00:00:00Z')) / 86400000) : 0;\nreturn {json:{valido:errores.length===0,errores,Cliente:cliente,Email:email,Entrada:entrada,Salida:salida,Huespedes:huespedes,Tipo:tipo,Noches:noches}};"
      },
