    {
      "parameters": {
        "jsCode": "const fila = $input.first().json || {};\nconst id = fila.id;\nif (!((typeof id === 'number' && Number.isSafeInteger(id) && id > 0) || (typeof id === 'string' && /^[1-9]\\d*$/.test(id)))) {\n  throw new Error('ESCRITURA_SIN_ID: Baserow no devolvió un identificador válido; comprobar tabla antes de reintentar');\n}\nconst habitacion = String($('Determinar disponibilidad').first().json.habitacion);\nif (fila.Habitacion !== undefined && String(fila.Habitacion) !== habitacion) {\n  throw new Error('ESCRITURA_INCONSISTENTE: número de habitación diferente');\n}\nif (fila.Estado !== undefined && String(fila.Estado).toLowerCase() !== 'confirmada') {\n  throw new Error('ESCRITURA_INCONSISTENTE: estado diferente de Confirmada');\n}\nreturn [{json:fila}];"
