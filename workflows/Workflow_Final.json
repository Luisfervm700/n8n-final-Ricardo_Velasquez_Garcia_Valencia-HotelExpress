    },
    {
      "parameters": {
        "jsCode": "const leer = nombre => {\n  const paginas = $(nombre).all();\n  if (!paginas.length) throw new Error('RESPUESTA_VACIA: ' + nombre);\n  const filas = [];\n  for (const p of paginas) {\n    if (!Array.isArray(p.json.results)) throw new Error('RESPUESTA_INESPERADA: ' + nombre);\n    filas.push(...p.json.results);\n  }\n  if (paginas[paginas.length-1].json.next) throw new Error('PAGINACION_INCOMPLETA: ' + nombre);\n  return filas;\n};\nconst fechaOK = s => /^\\d{4}-\\d{2}-\\d{2}$/.test(s) && Number.isFinite(new Date(s + 'T00:00:00Z').getTime()) && new Date(s + 'T00:00:00Z').toISOString().slice(0,10) === s;\nconst habitaciones = leer('Chat - Consultar habitaciones').map(h => {\n  const Numero = String(h.Numero ?? '').trim();\n  const Tipo = String(h.Tipo ?? '').trim();\n  const Activa = h.Activa === true || h.Activa === 1 || String(h.Activa).toLowerCase() === 'true';\n  if (!Numero || !Tipo) throw new Error('HABITACION_INCOMPLETA');\n  return {Numero, Tipo, Activa};\n});\nconst conocidas = new Set();\nfor (const h of habitaciones) {\n  if (conocidas.has(h.Numero)) throw new Error('NUMERO_HABITACION_DUPLICADO');\n  conocidas.add(h.Numero);\n}\nconst reservas = leer('Chat - Consultar reservas')\n  .filter(r => String(r.Estado || '').toLowerCase() === 'confirmada')\n  .map(r => {\n    const Habitacion = String(r.Habitacion ?? '').trim();\n    const Entrada = String(r.Entrada ?? '').slice(0,10);\n    const Salida = String(r.Salida ?? '').slice(0,10);\n    if (!Habitacion || !fechaOK(Entrada) || !fechaOK(Salida) || Salida <= Entrada) throw new Error('RESERVA_MALFORMADA');\n    return {Habitacion, Entrada, Salida};\n  });\nconst solicitud = $('When chat message received').first().json;\nreturn [{json:{chatInput:String(solicitud.chatInput||'').slice(0,2000),sessionId:String(solicitud.sessionId||$execution.id),habitaciones,reservas}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        2040
      ],
      "id": "82184b59-0b22-5424-843f-ae38b8589269",
      "name": "Chat - Contexto seguro",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Eres el asistente del Hotel Express. SOLO informas sobre la disponibilidad de habitaciones. No creas, editas ni cancelas reservas. Cuando soliciten disponibilidad, pide tipo de habitación y fechas de entrada/salida (AAAA-MM-DD) si faltan. Con los tres datos, llama SIEMPRE a la herramienta consultar_disponibilidad pasando un texto JSON como {\"tipo\":\"Doble\",\"fecha_entrada\":\"2026-12-10\",\"fecha_salida\":\"2026-12-12\"}. Responde usando UNICAMENTE el resultado de esa llamada, no inventes precios, condiciones ni habitaciones. Si la herramienta devuelve ok:false, explica que no fue posible consultar o pide corregir parámetros, PERO NUNCA declares disponibilidad sin un resultado ok:true. Las reservas se realizan por otro webhook. Mantén la memoria separada por sessionId."
        }
      },
