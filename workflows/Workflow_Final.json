      ],
      "id": "25967a8a-4a11-5fd6-a09a-35882253908b",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst raw = item.output ?? item;\nlet c = raw;\nif (typeof c === 'string') {\n  try { c=JSON.parse(c); } catch { throw new Error('SALIDA_IA_NO_JSON'); }\n}\nconst categorias = ['consulta_comercial','peticion_especial','otro'];\nif (!c || typeof c !== 'object' || !categorias.includes(c.categoria) || typeof c.resumen !== 'string' || typeof c.requiere_revision !== 'boolean') {\n  throw new Error('SALIDA_IA_INVALIDA: faltan campos o tipos requeridos');\n}\nconst resumen = c.resumen.trim().slice(0,500);\nif (!resumen) throw new Error('SALIDA_IA_INVALIDA: resumen vacío');\nconst requiere_revision = c.categoria === 'otro' || c.requiere_revision;\nreturn [{json:{categoria:c.categoria,resumen,requiere_revision}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
