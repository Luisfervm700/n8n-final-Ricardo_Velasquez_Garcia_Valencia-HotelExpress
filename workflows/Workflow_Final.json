      "name": "Gemini - Clasificador"
    },
    {
      "parameters": {
        "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"categoria\": {\n      \"type\": \"string\",\n      \"enum\": [\"consulta_comercial\", \"peticion_especial\", \"otro\"],\n      \"description\": \"Categoría asignada al mensaje\"\n    },\n    \"resumen\": {\n      \"type\": \"string\",\n      \"description\": \"Resumen conciso de la necesidad o hechos expuestos\"\n    },\n    \"requiere_revision\": {\n      \"type\": \"boolean\",\n      \"description\": \"true si la intención es ambigua o sospechosa\"\n    }\n  },\n  \"required\": [\"categoria\", \"resumen\", \"requiere_revision\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        880,
